{
  "name": "greencanteen-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node scripts/dev.js",
    "seed": "node src/seed.js",
    "claim-code": "node src/claim-code.js",
    "admin:bootstrap": "node src/admin-cli.js bootstrap",
    "admin:reset-mfa": "node src/admin-cli.js reset-mfa",
    "admin:reset-password": "node src/admin-cli.js reset-password",
    "admin:delete-user": "node src/admin-cli.js delete-user",
    "test": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "coverage": "node test/coverage/run.mjs",
    "e2e:server": "node test/e2e/server.mjs",
    "vision:download": "node scripts/vision-model.js download",
    "vision:verify": "node scripts/vision-model.js verify",
    "vision:evaluate": "node scripts/vision-evaluate.js",
    "vision:benchmark": "node scripts/benchmark-vision.js",
    "vision:selfcheck": "node scripts/vision-selfcheck.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@simplewebauthn/server": "14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.8.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "mongodb-memory-server": "^10.1.2"
  }
}
