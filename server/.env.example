PORT=3001
# production | development — production chặn mọi chế độ mô phỏng (nhận diện ảnh, email console, DB in-memory)
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/greencanteen
# Chỉ khi phát triển: không kết nối được MONGODB_URI thì dùng DB in-memory (MẤT dữ liệu khi tắt server)
MONGODB_MEMORY_FALLBACK=true
# Địa chỉ reverse proxy đứng trước server, để giới hạn tần suất theo IP thật. Bỏ trống nếu không có proxy.
# Nên khai báo địa chỉ hoặc dải: loopback (Nginx cùng máy), 10.0.0.5, 172.18.0.0/16 — X-Forwarded-For từ nguồn khác bị bỏ qua.
# Số proxy (vd. 1) chỉ an toàn khi cổng API không mở trực tiếp ra ngoài. true, *, 0.0.0.0/0 bị bỏ qua vì client sẽ tự đổi được IP.
TRUST_PROXY=

# ---------- Giới hạn chống dò mật khẩu và đăng ký hàng loạt (lưu trong MongoDB) ----------
# Ngưỡng theo IP phải rộng vì cả trường có thể dùng chung một IP NAT. Cách chọn theo sĩ số: README.md mục 8.9.
# Số lần đăng nhập SAI từ một IP trong cửa sổ (đăng nhập đúng không tính); cũng áp dụng cho lần xác minh email sai
AUTH_LOGIN_IP_MAX=100
AUTH_LOGIN_IP_WINDOW_MINUTES=15
# Số yêu cầu đăng ký / gửi lại thư xác minh từ một IP trong cửa sổ. Tăng tạm thời khi cả khối đăng ký cùng lúc
AUTH_REGISTER_IP_MAX=100
AUTH_REGISTER_IP_WINDOW_MINUTES=60
# Số thư xác minh gửi tới một địa chỉ email trong cửa sổ (chống dùng server để gửi thư hàng loạt cho một người)
AUTH_VERIFY_EMAIL_MAX=5
AUTH_VERIFY_EMAIL_WINDOW_MINUTES=60

# ---------- CAPTCHA tự chứa (bằng chứng công việc, không gọi dịch vụ ngoài) ----------
# adaptive (mặc định): chỉ hỏi khi có dấu hiệu dò. always: luôn hỏi. off: tắt.
# Chỉ làm mỗi lượt dò đắt hơn, KHÔNG phân biệt được người với máy. Không thay được giới hạn tần suất.
CAPTCHA_MODE=adaptive
# Số lần đăng nhập sai trên toàn hệ thống trong 15 phút rồi mọi lượt đăng nhập phải qua CAPTCHA (dò rải nhiều IP)
CAPTCHA_GLOBAL_FAILURES=200
# Số lần sai từ một IP trong 15 phút. Sai 3 lần với một email cũng phải qua CAPTCHA, không đổi được bằng biến này
CAPTCHA_IP_FAILURES=20
# Số yêu cầu gửi thư trong một giờ trên toàn hệ thống rồi đăng ký, quên mật khẩu, gửi lại thư phải qua CAPTCHA
CAPTCHA_GLOBAL_MAIL=300
# Số thử thách một IP được cấp trong 10 phút
CAPTCHA_ISSUE_PER_10_MINUTES=300
# Độ khó: số vòng PBKDF2 mỗi lần thử và số bit 0 đầu. Trung bình phải thử 2^bit lần, mỗi bit thêm làm thời gian chờ của người dùng gấp đôi
CAPTCHA_ITERATIONS=5000
CAPTCHA_DIFFICULTY_BITS=8

# ---------- Quét mã độc ảnh tải lên bằng ClamAV (clamd chạy TRONG mạng nội bộ) ----------
# Bỏ trống CLAMAV_HOST: tắt quét, server ghi cảnh báo khi khởi động. Đã khai báo mà clamd lỗi thì từ chối ảnh (503), không cho qua.
# Chỉ dùng máy của trường: ảnh của sinh viên được gửi tới máy này. Cài đặt: README.md mục 8.10
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# ---------- Nhận diện ảnh check-in (chạy TẠI MÁY CHỦ, ảnh không gửi cho dịch vụ cloud) ----------
# ensemble (mặc định): CLIP + VLM, CHỈ thưởng khi cả hai cùng nhận ra bình/ly cá nhân, cả ở lần nhìn lại trên ảnh đã làm mờ chữ.
#   CLIP chạy trong tiến trình Node, ngoại tuyến — cần tải mô hình 1 lần: npm run vision:download. VLM chạy trên Ollama trong mạng nội bộ.
# ollama: chỉ VLM — bị tắt khi NODE_ENV=production vì một mình VLM cũng bị chữ trong ảnh đánh lừa (F-26)
# clip: chỉ CLIP — check-in tắt, trừ khi đặt VISION_ALLOW_CLIP_ONLY=true (bị chặn khi production)
# off: tắt check-in bằng ảnh. Thiếu mô hình / cấu hình sai → check-in báo "chưa sẵn sàng", không bao giờ tự chấp nhận ảnh hay tự đổi chế độ
VISION_ENGINE=ensemble
# CHỈ để phát triển, bị chặn khi NODE_ENV=production: cho phép VISION_ENGINE=clip cấp thưởng
VISION_ALLOW_CLIP_ONLY=false
# Chỉ nhận mô hình có trong src/data/vision-models.json (đã ghim phiên bản + mã băm)
VISION_CLIP_MODEL=Xenova/clip-vit-base-patch16
# Bỏ trống → server/models. Server KHÔNG tự tải mô hình khi chạy; mã băm được kiểm lại trước khi nạp
VISION_MODEL_DIR=
# Chỉ chấp nhận loopback / mạng riêng (127.x, 10.x, 172.16–31.x, 192.168.x, fc00::/7...), localhost hoặc tên một nhãn
VISION_OLLAMA_URL=http://127.0.0.1:11434
# Cài trên máy Ollama (cần Ollama >= 0.12.7): ollama pull qwen3-vl:4b-instruct — Apache-2.0, ~3.3 GB.
# Tránh bản qwen2.5vl:3b: giấy phép qwen-research chỉ cho nghiên cứu / đánh giá.
# KHÔNG dùng mô hình cloud (tag :cloud / hậu tố -cloud): Ollama gửi ảnh lên ollama.com — server sẽ tắt check-in.
# Trên máy Ollama nên đặt OLLAMA_NO_CLOUD=1 (hoặc {"disable_ollama_cloud": true} trong ~/.ollama/server.json)
VISION_OLLAMA_MODEL=qwen3-vl:4b-instruct
# true CHỈ khi VISION_OLLAMA_URL là máy chủ của trường nằm ngoài các dải trên (vd. tên miền nội bộ nhiều cấp)
VISION_OLLAMA_TRUSTED_HOST=false
# Chỉ cộng thưởng khi là bình/ly cá nhân với độ tin cậy >= ngưỡng (0.5–1)
VISION_CONFIDENCE_THRESHOLD=0.8
# Dùng ollama / ensemble: nên đặt 60000 vì nạp mô hình có thể mất 5–20 giây (và OLLAMA_KEEP_ALIVE=-1 trên máy Ollama)
# Ollama chỉ dùng CPU: đặt 120000 (mức trần), mỗi lượt mất 40–90 giây trên 4–8 lõi thật. Bảng đo: README.md mục 8.2
VISION_TIMEOUT_MS=20000
# Số ảnh tối đa chờ nhận diện; vượt quá → 503 "máy chủ đang bận" thay vì để CPU quá tải
VISION_MAX_QUEUE=20
# CHỈ để phát triển, bị chặn khi NODE_ENV=production: trả kết quả cố định, gắn nhãn MÔ PHỎNG
VISION_SIMULATION=false
VISION_SIMULATED_CATEGORY=reusable_bottle
VISION_SIMULATED_CONFIDENCE=0.99
CHECKIN_MAX_IMAGE_MB=8
# Khoảng cách tối thiểu giữa hai check-in được thưởng (0 = tắt; khuyến nghị 30+ khi chạy thật)
CHECKIN_COOLDOWN_MINUTES=0
# Giữ thống kê công khai (bảng xếp hạng, thống kê trường) trong bộ nhớ chừng này giây để khách không làm server chạy lại truy vấn gộp
# cho mỗi yêu cầu. 0 = tắt, tối đa 300. Check-in, khóa tài khoản, đổi ảnh đại diện làm mới ngay trong cùng tiến trình.
STATS_CACHE_SECONDS=15

# Van xả khi một IP gửi dồn dập: quá ngưỡng trong một phút thì trả 429 trước khi đọc thân yêu cầu. /api/health không bị tính.
# Đếm trong bộ nhớ từng tiến trình. Ngưỡng phải rộng vì cả trường có thể dùng chung một IP NAT; 0 = tắt. Không thay được giới hạn ở proxy hay CDN.
API_RATE_LIMIT_PER_MINUTE=3000

# ---------- Email (xác minh đăng ký, quên mật khẩu) ----------
# smtp | console (console CHỈ để phát triển: in email, gồm cả liên kết, ra log, không gửi; bị chặn trong production)
# Thiếu SMTP_HOST / EMAIL_FROM → đăng ký bằng email và "Quên mật khẩu" hiển thị "Chưa cấu hình"
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER và EMAIL_FROM là địa chỉ Gmail, SMTP_PASS là mật khẩu ứng dụng 16 ký tự. Các bước: README.md mục 6.1
EMAIL_TRANSPORT=smtp
SMTP_HOST=
# 587 + SMTP_SECURE=false (STARTTLS bắt buộc) hoặc 465 + SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Chỉ cho máy SMTP thử nghiệm cục bộ không có TLS (Mailpit...)
SMTP_ALLOW_PLAINTEXT=false
EMAIL_FROM="GreenCanteen <no-reply@your-school.edu.vn>"
# Địa chỉ frontend: dùng cho CORS và làm trang đích sau khi đăng nhập Google/Facebook
CLIENT_ORIGIN=http://localhost:5173

# ---------- Phiên đăng nhập (cookie httpOnly) ----------
# true khi chạy HTTPS. Bỏ trống: tự bật khi NODE_ENV=production
COOKIE_SECURE=
# lax (mặc định — client và API cùng site) | none (client và API khác site, bắt buộc HTTPS)
COOKIE_SAMESITE=lax

# ---------- Google / Gmail (OAuth 2.0 / OpenID Connect) ----------
# Google Auth Platform > Clients > Create client (Web application). Các bước: README.md mục 6.1
# Bỏ trống ID hoặc secret → nút Google hiển thị "Chưa cấu hình"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải trùng khớp tuyệt đối với "Authorized redirect URIs" đã khai báo trên Google. Bỏ trống → <CLIENT_ORIGIN>/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ---------- Facebook Login ----------
# developers.facebook.com > My Apps > (app) > App settings > Basic. Các bước: README.md mục 6.1
# Bỏ trống ID hoặc secret → nút Facebook hiển thị "Chưa cấu hình"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Phải nằm trong "Valid OAuth Redirect URIs" của Facebook Login. Bỏ trống → <CLIENT_ORIGIN>/api/auth/facebook/callback
FACEBOOK_CALLBACK_URL=http://localhost:5173/api/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v23.0

# ---------- Đăng nhập bằng mã QR ----------
# Không cần nhà cung cấp bên ngoài. Đặt false để tắt phương thức này.
QR_LOGIN_ENABLED=true

# ---------- Khu quản trị (/admin) — hướng dẫn: README.md mục 7.3 ----------
# 32 byte ngẫu nhiên dạng base64 hoặc hex, dùng mã hóa secret MFA. Thiếu hoặc sai định dạng → mọi /api/admin trả 503.
# Tạo khóa: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đổi khóa làm mọi MFA hiện có mất tác dụng (phải chạy lại npm run admin:reset-mfa cho từng admin). Không đưa vào mã nguồn.
ADMIN_MFA_KEY=
# Phiên quản trị riêng, ngắn hơn nhiều so với phiên sinh viên (30 ngày)
ADMIN_SESSION_IDLE_MINUTES=15
ADMIN_SESSION_MAX_HOURS=8
# Khoảng thời gian một lần nhập lại mật khẩu + mã MFA còn hiệu lực cho thao tác nhạy cảm
ADMIN_REAUTH_MINUTES=5

# ---------- Thống kê truy cập (lượt xem, lượt truy cập, người dùng hoạt động, tỉ lệ nhấp) ----------
# false: không thu thập gì, màn hình tổng quan báo "chưa có nguồn dữ liệu"
ANALYTICS_ENABLED=true
# Khóa HMAC tạo mã ẩn danh theo tháng cho chỉ số người dùng hoạt động. Bỏ trống → không có chỉ số này.
# Tạo khóa như ADMIN_MFA_KEY, dùng khóa KHÁC.
ANALYTICS_HASH_KEY=
# Sự kiện thô tự xóa sau số ngày này (7–395)
ANALYTICS_RETENTION_DAYS=90
